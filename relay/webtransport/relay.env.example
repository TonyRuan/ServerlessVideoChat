# Configure an HTTPS endpoint with a public CA certificate and DNS-only hostname.
WT_BIND=127.0.0.1:4433
WT_CERT_FILE=/etc/svc-webtransport/fullchain.pem
WT_KEY_FILE=/etc/svc-webtransport/privkey.pem
WT_ORIGINS=https://chat.uavserver.cn,https://serverlessvideochat.pages.dev,https://localhost
WT_MAX_ROOMS=64
WT_MAX_SESSIONS_PER_IP=16
